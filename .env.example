# --- Required ---

# Google Maps Platform API key with "Places API (New)" enabled.
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_MAPS_API_KEY=

# Claude (Anthropic) API key — the default AI models are Claude models.
# Create one at https://console.anthropic.com/ under "API keys".
ANTHROPIC_API_KEY=

# OpenAI API key — only needed if you switch the AI model in Settings to a
# GPT model. Leave empty when using the default Claude models.
OPENAI_API_KEY=

# SQLite (default, zero setup). For PostgreSQL, also change the provider in
# prisma/schema.prisma to "postgresql", e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/dubai_leadgen"
DATABASE_URL="file:./dev.db"

# Base URL of the app (used for preview links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Authentication (MVP email/password login) ---
# If ADMIN_EMAIL / ADMIN_PASSWORD are left empty, login is disabled and the
# dashboard is open (convenient for local development only).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random string used to sign session cookies. Required when login is enabled.
AUTH_SECRET=

# --- Optional: website verification via Google Custom Search (Programmable Search Engine) ---
# Used by the "verify website" step to check whether a business has a website
# that just isn't listed on its Google Maps profile. Leave empty to rely on the
# Places `websiteUri` field only.
# https://developers.google.com/custom-search/v1/overview
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- Optional: demo-link publishing (Netlify) ---
# Personal access token from https://app.netlify.com/user/applications#personal-access-tokens
# Powers the "Publish demo link" button: pushes a draft to an unguessable
# *.netlify.app URL you can share with the business owner on WhatsApp.
NETLIFY_TOKEN=
